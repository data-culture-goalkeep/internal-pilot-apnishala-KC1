# Copy to .env.local and fill in with values from the Supabase project
# (Settings -> API). This app shares the same Goalkeep Supabase project as
# key-questions-interface, using its own `khoj_dashboard` schema.
# SUPABASE_SERVICE_ROLE_KEY is server-only, used by the seed script — never
# expose it to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
